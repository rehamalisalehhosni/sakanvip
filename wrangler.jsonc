// SakanVIP on Cloudflare Workers: static storefront + API in one Worker.
// Secrets (SMTP_PASS, STRIPE_SECRET_KEY, PAYPAL_CLIENT_SECRET, ...) are set in the Cloudflare
// dashboard (Settings -> Variables and Secrets, type Secret), never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakanvip-cf",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  // Copies index.html and the images into dist/ before every dev run and deploy.
  "build": { "command": "node scripts/build-assets.mjs", "watch_dir": "worker" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  // 8 API calls per minute per visitor and route (the old Express server allowed 8 per 15 min).
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }
  ],
  // Public values; secrets go in the dashboard.
  "vars": {
    "CANONICAL_HOST": "sakanapp.net",
    "SUPABASE_URL": "https://kxkxakcwvvreyzyzzqem.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_BIkVwJQT5c_ycJQQU0GPTg_pJrONYQ3",
    "SMTP_HOST": "smtps.udag.de",
    "SMTP_PORT": "465",
    "SMTP_USER": "info@digital-future.ai",
    "MAIL_FROM": "SakanVIP <info@digital-future.ai>",
    "MAIL_TO_INFO": "info@digital-future.ai",
    "MAIL_TO_SERVER": "server@digital-future.ai",
    "PAYPAL_MODE": "live",
    // Seller data printed on every invoice (required by § 14 UStG). SHOP_ADDRESS lines are split on "|".
    // SHOP_VAT_RATE: 19 = prices include 19 % VAT; 0 = small business, no VAT (§ 19 UStG).
    "SHOP_NAME": "SAKANVIP",
    "SHOP_LEGAL_NAME": "SAKAN",
    "SHOP_ADDRESS": "Ehndorfer Str. 130|24537 Neumünster|Deutschland",
    "SHOP_TAX_ID": "Steuernummer: 544-208-174-435",
    "SHOP_VAT_RATE": "0",
    // CJ fulfilment (worker/cj.js). CJ_AUTO_PAY "on" pays CJ orders from the CJ wallet; "off" leaves them
    // waiting in CJ for the owner. CJ_IOSS_TYPE 3 = CJ collects EU import VAT. CJ_SANDBOX "on" makes test orders only.
    "CJ_AUTO_PAY": "off",
    "CJ_IOSS_TYPE": "3",
    "CJ_SANDBOX": "off",
    // Before auto-paying: hold the order if CJ's cost is above this share of the sale, and email the owner
    // when the CJ wallet drops below CJ_LOW_BALANCE_USD.
    "CJ_MAX_COST_SHARE": "0.6",
    "CJ_LOW_BALANCE_USD": "100"
  },
  // Every 30 minutes: send paid orders that are not at CJ yet (and pay them when auto-pay is on).
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true }
}
