# Copy to .env on the API host; never commit real credentials.
NODE_ENV=production
PORT=3000
PUBLIC_API_URL=https://api.example.com
ALLOWED_ORIGIN=https://sakan-app.github.io
DATABASE_FILE=./data/sakanvip.sqlite

# UDAG outgoing SMTP. Use 465/TLS or 587/STARTTLS.
SMTP_HOST=smtps.udag.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@digital-future.ai
SMTP_PASS=REPLACE_WITH_UDAG_MAILBOX_PASSWORD
MAIL_FROM="SakanVIP <info@digital-future.ai>"
MAIL_TO_INFO=info@digital-future.ai
MAIL_TO_SERVER=server@digital-future.ai

# Mailbox access is for the mailbox host/operator, not browser code.
IMAP_HOST=imaps.udag.de
IMAP_PORT=993
POP3_HOST=pops.udag.de
POP3_PORT=995

# Supabase public catalogue access (public anon/publishable key only; service-role key is not needed here)
SUPABASE_URL=https://kxkxakcwvvreyzyzzqem.supabase.co
SUPABASE_ANON_KEY=sb_publishable_BIkVwJQT5c_ycJQQU0GPTg_pJrONYQ3

# Stripe Checkout (server-side secret; never put in index.html)
STRIPE_SECRET_KEY=sk_live_REPLACE_IN_HOST_SECRETS
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_IN_HOST_SECRETS

# PayPal Live Orders API. Configure matching Live Client ID and Secret in the API host's secret store.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_PAYPAL_CLIENT_SECRET
CHECKOUT_SUCCESS_URL=https://sakan-app.github.io/sakanvip/?payment=success
CHECKOUT_CANCEL_URL=https://sakan-app.github.io/sakanvip/?payment=cancel

# CJ Dropshipping remote MCP. Set both as encrypted secrets on the backend host only.
CJ_MCP_TOKEN=REPLACE_WITH_ROTATED_CJ_MCP_TOKEN
CJ_MCP_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_ADMIN_TOKEN
