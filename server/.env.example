# Copy to .env on the API host; never commit real credentials.
NODE_ENV=production
PORT=3000
PUBLIC_API_URL=https://api.example.com
ALLOWED_ORIGIN=https://sakan-app.github.io
DATABASE_FILE=./data/sakanvip.sqlite

# UDAG outgoing SMTP. Use 465/TLS or 587/STARTTLS.
SMTP_HOST=smtps.udag.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@digital-future.ai
SMTP_PASS=REPLACE_WITH_UDAG_MAILBOX_PASSWORD
MAIL_FROM="SakanVIP <info@digital-future.ai>"
MAIL_TO_INFO=info@digital-future.ai
MAIL_TO_SERVER=server@digital-future.ai

# Mailbox access is for the mailbox host/operator, not browser code.
IMAP_HOST=imaps.udag.de
IMAP_PORT=993
POP3_HOST=pops.udag.de
POP3_PORT=995
